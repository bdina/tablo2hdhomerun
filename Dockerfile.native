# To build image run `docker build --tag tablo2hdhomerun:<version> .`

# Multi-stage image ... creates intermediate layer(s) for doing the graalvm native
# build (this is discarded by docker post-build)
FROM ubuntu:24.04 AS build

ARG GRAAL_VERSION=25.5.5.0.3
ARG JAVA_VERSION=25i5-25.0.5.0.3
ARG GRAALVM_WORKDIR=/graalvm/src/project

ARG GRADLE_VERSION=9.3.1

# Install tools required for project
# Run `docker build --no-cache .` to update dependencies
RUN apt-get update -y \
 && apt-get upgrade -y \
 && apt-get install -y wget unzip build-essential zlib1g-dev ca-certificates \
 && apt-get autoremove --purge -y \
 && wget https://github.com/graalvm/graalvm-ce-builds/releases/download/graal-${GRAAL_VERSION}/graalvm-community-jdk-${JAVA_VERSION}_linux-x64_bin.tar.gz -P /tmp \
 && mkdir -p /opt/graalvm-community-jdk-${JAVA_VERSION} \
 && tar zxvf /tmp/graalvm-community-jdk-${JAVA_VERSION}_linux-x64_bin.tar.gz -C /opt/graalvm-community-jdk-${JAVA_VERSION} --strip-components 1 \
 && wget https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip -P /tmp \
 && unzip -d /opt /tmp/gradle-${GRADLE_VERSION}-bin.zip \
 && DEBIAN_FRONTEND=noninteractive TZ=America/New_York apt-get -y install tzdata \
 && rm -rf /tmp/*.tar.gz /tmp/*.zip /var/lib/apt/lists/*
# && DEBIAN_FRONTEND=noninteractive TZ=America/New_York apt-get -y install tzdata ffmpeg

ARG MUSL_VERSION=11.2.1
ARG ZLIB_VERSION=1.4

RUN wget https://more.musl.cc/${MUSL_VERSION}/x86_64-linux-musl/x86_64-linux-musl-native.tgz -P /tmp \
 && mkdir /opt/musl-${MUSL_VERSION} \
 && tar -zxvf /tmp/x86_64-linux-musl-native.tgz -C /opt/musl-${MUSL_VERSION}/ \
 && wget https://zlib.net/zlib-${ZLIB_VERSION}.tar.gz -P /tmp \
 && tar -zxvf /tmp/zlib-${ZLIB_VERSION}.tar.gz -C /tmp \
 && rm -f /tmp/x86_64-linux-musl-native.tgz /tmp/zlib-${ZLIB_VERSION}.tar.gz

# Build MUSL to static link into application
ENV TOOLCHAIN_DIR=/opt/musl-${MUSL_VERSION}/x86_64-linux-musl-native

ENV PATH=$PATH:${TOOLCHAIN_DIR}/bin
ENV CC=$TOOLCHAIN_DIR/bin/gcc

WORKDIR /tmp/zlib-${ZLIB_VERSION}
RUN ./configure --prefix=${TOOLCHAIN_DIR} --static \
 && make \
 && make install \
 && rm -rf /tmp/zlib-${ZLIB_VERSION}/

ENV GRADLE_HOME=/opt/gradle-${GRADLE_VERSION}
ENV JAVA_HOME=/opt/graalvm-community-jdk-${JAVA_VERSION}
ENV PATH=${JAVA_HOME}/bin:${GRADLE_HOME}/bin:${SCALA_HOME}/bin:${PATH}

WORKDIR ${GRAALVM_WORKDIR}

# Warm Gradle plugins, buildSrc, and runtime/compiler caches in a separate layer
COPY .m2-local /root/.m2/repository
COPY settings.gradle build.gradle gradle.properties ${GRAALVM_WORKDIR}/
COPY buildSrc ${GRAALVM_WORKDIR}/buildSrc
RUN test -d /root/.m2/repository/com/scalarometer || { echo "ERROR: .m2-local/com/scalarometer missing — run ./docker-build-image.sh native first" >&2; exit 1; } \
 && ${GRADLE_HOME}/bin/gradle -q --no-daemon --no-build-cache --no-watch-fs -PskipGitVersion=true warmDependencyCache \
 && rm -rf ${GRAALVM_WORKDIR}/build ${GRAALVM_WORKDIR}/.gradle

ARG REQUIRE_CLEAN_VERSION=false

# Copy the entire project and build it offline from cached dependencies
COPY . ${GRAALVM_WORKDIR}
RUN ${GRADLE_HOME}/bin/gradle -q --no-daemon --offline --no-build-cache --no-watch-fs -PsingleShotCompile=true -PrequireCleanVersion=${REQUIRE_CLEAN_VERSION} nativeImage

# Create the minimal runtime image
FROM scratch AS app

LABEL org.opencontainers.image.title="tablo2hdhomerun" \
      org.opencontainers.image.description="HDHomeRun compatible network TV Tuner API proxy for Tablo TV devices (native)"

ENV APP_HOME=/opt/tablo2hdhomerun
ENV PATH=${APP_HOME}:${PATH}
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

WORKDIR ${APP_HOME}

COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=build /graalvm/src/project/build/tablo2hdhomerun* ${APP_HOME}/

EXPOSE 8080/tcp 65001/udp

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD [ "/opt/tablo2hdhomerun/tablo2hdhomerun", "--healthcheck" ]

CMD [ "./tablo2hdhomerun" , "-d" ]
