# To build image Run `docker build -f Dockerfile.jvm --tag tablo2hdhomerun:<version> .`

ARG OPENJDK_VERSION=25
ARG OPENJDK_WORKDIR=/openjdk/src/project

# Multi-stage image ... creates intermediate layer(s) for doing the graalvm native
# build (this is discarded by docker post-build)
FROM eclipse-temurin:${OPENJDK_VERSION}-jdk-alpine AS build

ARG GRADLE_VERSION=9.3.1
ARG OPENJDK_WORKDIR=/openjdk/src/project

# Install tools required for project
# Run `docker build --no-cache .` to update dependencies
RUN apk add --no-cache wget unzip \
 && wget -q https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip -P /tmp \
 && unzip -q -d /opt /tmp/gradle-${GRADLE_VERSION}-bin.zip \
 && rm -f /tmp/gradle-${GRADLE_VERSION}-bin.zip

ENV GRADLE_HOME=/opt/gradle-${GRADLE_VERSION}
ENV PATH=${GRADLE_HOME}/bin:${PATH}

WORKDIR ${OPENJDK_WORKDIR}

# Warm Gradle plugins, buildSrc, and runtime/compiler caches in a separate layer
COPY settings.gradle build.gradle gradle.properties ${OPENJDK_WORKDIR}/
COPY buildSrc ${OPENJDK_WORKDIR}/buildSrc
RUN ${GRADLE_HOME}/bin/gradle -q --no-daemon --no-build-cache --no-watch-fs -PskipGitVersion=true warmDependencyCache \
 && rm -rf ${OPENJDK_WORKDIR}/build ${OPENJDK_WORKDIR}/.gradle

ARG REQUIRE_CLEAN_VERSION=false

# Copy the entire project and build it offline from cached dependencies
COPY . ${OPENJDK_WORKDIR}
RUN ${GRADLE_HOME}/bin/gradle -q --no-daemon --offline --no-build-cache --no-watch-fs -PsingleShotCompile=true -PrequireCleanVersion=${REQUIRE_CLEAN_VERSION} shadowJar

# This results in a single layer image
#FROM alpine AS tablo2hdhomerun
FROM eclipse-temurin:${OPENJDK_VERSION}-jre-alpine AS tablo2hdhomerun-base

ARG OPENJDK_WORKDIR=/openjdk/src/project

ENV tablo2hdhomerun_HOME=/opt/tablo2hdhomerun
ENV PATH=${tablo2hdhomerun_HOME}/bin:${PATH}

WORKDIR ${tablo2hdhomerun_HOME}

COPY --from=build ${OPENJDK_WORKDIR}/build/libs/tablo2hdhomerun-*.jar ${tablo2hdhomerun_HOME}/tablo2hdhomerun.jar

RUN java --sun-misc-unsafe-memory-access=allow \
         -XX:+UseCompactObjectHeaders \
         -XX:+UseSerialGC \
         -XX:ArchiveClassesAtExit=app-cds.jsa \
         -Djava.net.preferIPv4Stack=true \
         -jar tablo2hdhomerun.jar --healthcheck ; \
    test -f app-cds.jsa

EXPOSE 8080/tcp 65001/udp

# And we finally create the application layer
FROM tablo2hdhomerun-base AS tablo2hdhomerun
LABEL org.opencontainers.image.title="tablo2hdhomerun" \
      org.opencontainers.image.description="HDHomeRun compatible network TV Tuner API proxy for Tablo TV devices (JVM)"
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD [ "java", "--sun-misc-unsafe-memory-access=allow", "-XX:+UseCompactObjectHeaders", "-XX:+UseSerialGC", "-XX:SharedArchiveFile=app-cds.jsa", "-Xshare:auto", "-Xms4m", "-Xmx16m", "-XX:MaxNewSize=8m", "-Djava.net.preferIPv4Stack=true", "-jar", "tablo2hdhomerun.jar", "--healthcheck" ]
ENTRYPOINT [ "java" ]
CMD [ "--sun-misc-unsafe-memory-access=allow", "-XX:+UseCompactObjectHeaders", "-XX:+UseSerialGC", "-XX:SharedArchiveFile=app-cds.jsa", "-Xshare:auto", "-Xms32m", "-Xmx128m", "-XX:MaxNewSize=64m", "-Xss256k", "-XX:+ExitOnOutOfMemoryError", "-Djava.net.preferIPv4Stack=true", "-jar", "tablo2hdhomerun.jar", "-d" ]
